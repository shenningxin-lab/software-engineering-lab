@startuml
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam dpi 150
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFF7F3
skinparam classBorderColor #D9875F
skinparam linetype ortho

abstract class User {
  -用户名
  -密码
  -电话
}
class Customer
class Merchant
class Courier
class Admin

class Shop {
  -店名
  -地址
  -营业状态
}
class Dish {
  -名称
  -价格
  -库存
}
class CartItem {
  -菜品
  -口味
  -数量
}
class Order {
  -订单号
  -状态
  -金额
}
class OrderItem {
  -菜品名
  -口味
  -单价
  -数量
}
class DeliveryTask {
  -状态
}

User <|-- Customer
User <|-- Merchant
User <|-- Courier
User <|-- Admin

Merchant "1" -- "1" Shop
Shop "1" -- "*" Dish
Shop "1" -- "*" Order
Customer "1" -- "*" CartItem
CartItem "*" -- "1" Dish
Customer "1" -- "*" Order
Order "1" -- "*" OrderItem
OrderItem "*" -- "1" Dish
Order "1" -- "0..1" DeliveryTask
Courier "1" -- "*" DeliveryTask
@enduml
